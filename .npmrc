# package.json の engines を満たさない環境では install を失敗させる。
# スタックを「書いてあるだけ」ではなく強制されるものにするための設定。
engine-strict=true

# Medusa と Mercur は「1プロセスに1つだけ」であることを前提にした依存を持つ。
# pnpm の既定（厳密な隔離）のままだと同じパッケージの実体が複数でき、
# 実行時にモジュールの解決へ失敗する。テンプレート付属の .npmrc と同じ内容を、
# pnpm がワークスペース全体で読む位置（リポジトリ直下）に置く。
# 出典: Mercur の templates/basic/packages/api/.npmrc
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
auto-install-peers=true

# 注意: このファイルは配布・共有される。認証トークンを書かないこと。
# トークンは ~/.npmrc（ユーザー単位）に置く。
